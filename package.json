{
  "name": "@storminterview/paperclip-cli",
  "version": "0.1.0",
  "description": "End-to-end CLI for controlling Paperclip + storminterview org-bridge + hermes",
  "type": "module",
  "bin": {
    "paperclip": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "paperclip",
    "cli",
    "storminterview",
    "org-bridge",
    "hermes",
    "agent",
    "management"
  ],
  "author": "storminterview",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/storminterview/paperclip-cli.git"
  },
  "bugs": {
    "url": "https://github.com/storminterview/paperclip-cli/issues"
  },
  "homepage": "https://github.com/storminterview/paperclip-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
